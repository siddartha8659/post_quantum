# ============================================================================
# PQ-ABAC-EHR: Supabase & Cryptographic Environment Variables
# ============================================================================

# Supabase Project API URL (Found in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Found in Supabase Dashboard -> Settings -> API -> Project API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Used for server-side administrative workflows and seed automation)
# CAUTION: Never expose this key in public client-side browser code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Optional Master Cryptographic Authority Seed (64-byte hex string)
# Leave blank to use deterministic default root authority
PQC_MASTER_AUTHORITY_SEED=
