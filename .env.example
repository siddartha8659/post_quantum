# ============================================================================
# PQ-ABAC-EHR: Post-Quantum Attribute-Based Access Control Environment Variables
# ============================================================================

# 1. Supabase Project Configuration
# Supabase Project API URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Dashboard -> Project Settings -> API -> Project API Keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Server-side administrative workflows and RLS automation)
# CAUTION: Never expose this key in public client-side browser code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 2. Email Service Configuration (Resend API)
# Get your API key from https://resend.com/api-keys
# When configured, 6-digit numeric login OTPs are dispatched to staff emails.
# If omitted or running locally, OTP codes are logged to the server console
# and returned via demoOtp in the dev API response for turn-key testing.
RESEND_API_KEY=re_your_resend_api_key_here

# 3. Optional Master Cryptographic Authority Seed (64-byte hex string)
# Leave blank to use the deterministic default root authority
PQC_MASTER_AUTHORITY_SEED=
